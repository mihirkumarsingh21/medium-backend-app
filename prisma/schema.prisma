

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id             Int @id @default(autoincrement())
  username       String 
  email          String  @unique
  password       String
  role           Role    @default(USER)
  articles       Article[]
  comments       Comment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  USER
  AUTHOR
}

model Article {
  id              Int      @id @default(autoincrement())
  title           String   @unique
  description     String?
  body            String
  user_id         Int
  user            User     @relation(fields: [user_id], references: [id])
  comments        Comment[]
  tags            Tag[]  
  category_id     Int? @unique
  category        Category? @relation(fields: [category_id], references: [id])   
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Comment {
  id             Int          @id      @default(autoincrement())
  comments        String?
  user_id        Int?         
  user User?               @relation(fields: [user_id], references: [id])
  article_id     Int? 
  article Article?         @relation(fields: [article_id], references: [id])
}


model Tag {
    id  Int  @id @default(autoincrement())
    name String @unique
    articles Article[] 
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  articles Article[]
}


