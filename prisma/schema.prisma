

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id             Int @id @default(autoincrement())
  username       String 
  email          String  @unique
  password       String
  role           Role    @default(USER)
  articles       Article[] 
  comments       Comment[]
  reactions       Reaction[]
  followers      Follow[] @relation("UserFollowers")
  following      Follow[] @relation("UserFollowing")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Role {
  USER
  AUTHOR
}

model Article {
  id              Int      @id @default(autoincrement())
  title           String   @unique
  description     String?
  body            String
  user_id         Int
  user            User     @relation(fields: [user_id], references: [id])
  comments        Comment[]
  tags            Tag[]  
  category_id     Int? @unique
  category        Category? @relation(fields: [category_id], references: [id])  
  reactions        Reaction[] 
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Comment {
  id             Int          @id      @default(autoincrement())
  comments        String?
  user_id        Int?         
  user User?               @relation(fields: [user_id], references: [id])
  article_id     Int? 
  article Article?         @relation(fields: [article_id], references: [id])
}


model Tag {
    id  Int  @id @default(autoincrement())
    name String @unique
    articles Article[] 
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  articles Article[]
}

model Reaction {
  id               Int                @id @default(autoincrement())
  user_id          Int?
  user User?                            @relation(fields: [user_id], references: [id])
  article_id       Int 
  article Article                      @relation(fields: [article_id], references: [id])
  type  ReactionType                   @default(DISLIKE)
  like             Int                 @default(0)
  dislike          Int                 @default(0)
  @@unique([user_id, article_id])
}

enum ReactionType {
  LIKE
  DISLIKE
}


model Follow {
  id            Int  @id @default(autoincrement())

  follower_id   Int
  follower      User @relation("UserFollowers", fields: [follower_id], references: [id])
  followerCount Int? @default(0)

  type          FollowType @default(UNFOLLOW)

  following_id  Int?
  following     User? @relation("UserFollowing", fields: [following_id], references: [id])
  followingCount Int? @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([follower_id, following_id])
}


enum FollowType {
  FOLLOW 
  UNFOLLOW
}

